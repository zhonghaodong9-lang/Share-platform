# ==========================================
# 微信自动推送配置 (二选一即可)
# ==========================================

# 微信推送方案 1: WxPusher (推荐：免费、稳定、扫码关注公众号即收到卡片通知)
# 获取步骤：打开 http://wxpusher.zhengxianliang.com/ 创建应用获得 AppToken，微信扫码关注应用获得 UID
WXPUSHER_APP_TOKEN=AT_xxxxxxxxxxxxxxxx
WXPUSHER_UIDS=UID_xxxxxxxxxxxxxxxx

# 微信推送方案 2: Server酱 (方糖推送)
# 获取步骤：打开 https://sct.ftqq.com 微信扫码登录获得 SendKey
SERVERCHAN_SENDKEY=SCTxxxxxxxxxxxxxxxx

# ==========================================
# 其他办公软件 Webhook 配置 (可选)
# ==========================================
FEISHU_WEBHOOK=
DINGTALK_WEBHOOK=
WECOM_WEBHOOK=

# ==========================================
# AI 大模型配置 (可选，填入 DeepSeek / OpenAI Key)
# ==========================================
AI_PROVIDER=deepseek
AI_API_KEY=sk-xxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 输出目录
OUTPUT_DIR=./reports
